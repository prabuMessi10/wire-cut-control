# ------------------------------------------------------------------
# Wire Cut Control - server environment variables
# Copy this file to .env and adjust the values for your machine.
# ------------------------------------------------------------------

# Port the REST API listens on
PORT=5000

# Set to "production" when deploying behind HTTPS
NODE_ENV=development

# MongoDB connection string.
#   Real MongoDB:  mongodb://127.0.0.1:27017/wire_cut_control
#   No MongoDB installed? Set MONGODB_MEMORY=true to run an ephemeral
#   in-memory MongoDB automatically (data is lost on restart, admin is
#   auto-bootstrapped at server start).
MONGO_URI=mongodb://127.0.0.1:27017/wire_cut_control
MONGODB_MEMORY=false

# JWT signing secret - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-secret-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Default ESP32 controller IP (can be overridden at runtime from the Settings drawer)
ESP32_IP=192.168.1.42

# Initial demo-mode default ("true" unless this is set to "false")
ESP32_DEMO_DEFAULT=true

# OPTIONAL - speed up MONGODB_MEMORY=true boot by pointing at an already
# downloaded mongod binary instead of letting mongodb-memory-server find one.
# (MONGOMS_SYSTEM_BINARY is also respected.)
# MONGOD_BIN=C:\full\path\to\mongod.exe

# Frontend origin(s) allowed by CORS (comma separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# Bootstrap admin account used by `npm run seed`
ADMIN_EMAIL=admin@wirecut.local
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=System Administrator
